<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Text?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.musec.client.controller.MainController" stylesheets="@../css/app.css">
    
    <!-- LEFT: Sidebar -->
    <left>
        <VBox fx:id="sidebar" styleClass="sidebar" spacing="15">
            <padding>
                <Insets top="20" right="15" bottom="20" left="15"/>
            </padding>
            <Label text="Musec" styleClass="logo-text"/>
            
            <Separator styleClass="sidebar-separator"/>
            
            <Button text="Home" styleClass="sidebar-btn"/>
            <Button text="Search" styleClass="sidebar-btn"/>
            <Button text="Your Library" styleClass="sidebar-btn"/>
            
            <Region VBox.vgrow="ALWAYS"/>
            
            <Button text="Settings" styleClass="sidebar-btn"/>
        </VBox>
    </left>
    
    <!-- CENTER: Main Content Area -->
    <center>
        <StackPane styleClass="main-content">
            <Label text="Welcome to Musec" styleClass="welcome-text"/>
        </StackPane>
    </center>
    
    <!-- BOTTOM: Playback Bar -->
    <bottom>
        <HBox styleClass="playback-bar" alignment="CENTER_LEFT" spacing="20">
            <padding>
                <Insets top="10" right="20" bottom="10" left="20"/>
            </padding>
            
            <!-- Track Info -->
            <VBox alignment="CENTER_LEFT" minWidth="200">
                <Label fx:id="nowPlayingTitle" text="Track Title" styleClass="track-title"/>
                <Label fx:id="nowPlayingArtist" text="Artist Name" styleClass="track-artist"/>
            </VBox>
            
            <!-- Controls -->
            <VBox alignment="CENTER" HBox.hgrow="ALWAYS" spacing="5">
                <HBox alignment="CENTER" spacing="15">
                    <Button text="⏮" onAction="#handlePreviousTrack" styleClass="control-btn"/>
                    <Button text="▶" onAction="#handlePlayPause" styleClass="control-btn-main"/>
                    <Button text="⏭" onAction="#handleNextTrack" styleClass="control-btn"/>
                </HBox>
                <HBox alignment="CENTER" spacing="10">
                    <Label text="0:00" styleClass="time-text"/>
                    <Slider fx:id="progressSlider" HBox.hgrow="ALWAYS" maxWidth="400"/>
                    <Label text="3:45" styleClass="time-text"/>
                </HBox>
            </VBox>
            
            <!-- Volume -->
            <HBox alignment="CENTER_RIGHT" spacing="10" minWidth="150">
                <Label text="🔊" styleClass="icon-text"/>
                <Slider fx:id="volumeSlider" prefWidth="100"/>
            </HBox>
            
        </HBox>
    </bottom>

</BorderPane>
